# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments & local config
venv/
.venv/
env/
.env

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Logs and build artifacts
*.log
logs/
build/
dist/
*.egg-info/
.ipynb_checkpoints/

# Local developer notes & scratch files
PROJECT_REPORT.md
*.local.md
.*.local.md

# Large models & weights (YOLO weights ~50MB auto-downloaded on first run)
*.pt
Object Detection/*.pt
Object Detection/src/*.pt

# Allow 32KB pre-trained Q-table policy
!q_table.npy
!Q-Learning model/src/q_table.npy
